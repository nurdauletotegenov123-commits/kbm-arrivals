# Скопируйте в .env и заполните:  cp .env.example .env

# Длинная случайная строка (сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=замените-на-случайную-строку
DJANGO_DEBUG=0
# Адреса, по которым открывают сайт (имя сервера и/или IP), через запятую
DJANGO_ALLOWED_HOSTS=arrivals.kbm.local,10.0.0.15,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS (когда будет домен, см. README «HTTPS») ---
# Домен, который смотрит на этот сервер, например arrivals.kbm.kz
DOMAIN=
# 1 — сайт работает по HTTPS через встроенный Caddy (запуск: docker compose --profile https up -d)
DJANGO_HTTPS=0

POSTGRES_DB=kbm
POSTGRES_USER=kbm
POSTGRES_PASSWORD=замените-пароль-базы

# Порт на сервере
WEB_PORT=8000
TIME_ZONE=Asia/Aqtau

# 1 — при запуске создать тестовые аккаунты и данные (только для пробного запуска!)
SEED_DEMO=0

# Сколько дней «не прибывшие» остаются в отдельном красном блоке у охраны/кэмпа
NO_SHOW_DAYS=2

# Вход по доменной учётной записи (Active Directory). Пусто — только локальные пароли. См. README «Вход через AD».
AD_HOST=
# AD_HOST=AOS22-DC02.KBM.KZ
AD_DOMAIN=KBM.KZ
AD_BASE_DN=OU=KBM JSC,DC=KBM,DC=KZ
AD_SECURITY=ldaps
AD_CA_CERT=
AD_DEFAULT_ROLE=applicant
AD_GROUP_ADMIN=
AD_GROUP_CHIEF=
AD_GROUP_SECURITY=
AD_GROUP_DISPATCHER=
AD_GROUP_CAMP=
AD_GROUP_SUPPLY=
# Служебная учётка только для чтения — для синхронизации (python manage.py ad_sync)
AD_BIND_USER=
AD_BIND_PASSWORD=

# Регистрация подрядчиков и гостей с телефона (0 — закрыть, аккаунты заводит только админ)
SIGNUP_ENABLED=0
# Почта для запроса доступа (подрядчики, гости, сотрудники вне домена) — показывается на странице входа
ACCESS_EMAIL=N_Otegenov@kbm.kz
SIGNUPS_PER_HOUR=10
LOGIN_FAILS_LIMIT=10

# Почтовые уведомления службам (если не задано — письма не уходят, только пишутся в лог)
# Внутренняя почта (Exchange). Что спросить у ИТ — README, раздел «Почтовые уведомления».
# Вариант 1 — внутренний relay без пароля: EMAIL_HOST=адрес, EMAIL_PORT=25, остальное пусто.
# Вариант 2 — служебный ящик с паролем: EMAIL_PORT=587, EMAIL_USE_TLS=1, логин и пароль ящика.
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=arrivals@kbm.kz
SITE_URL=http://arrivals.kbm.local:8000
NOTIFICATIONS_ENABLED=1

# Telegram-бот уведомлений — выключен (в корпоративной сети запрещён). См. README «Уведомления в Telegram»
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
